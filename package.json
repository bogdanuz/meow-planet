{
  "name": "meow-planet",
  "private": true,
  "version": "0.16.3",
  "type": "module",
  "description": "Planeta Meow PWA mini-games hub for toddlers 2-3 (iPad)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-precache-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:boot": "playwright test --config=playwright.boot.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "assets:menu-cards": "node scripts/process-menu-cards.mjs",
    "assets:balloon-pop": "node scripts/build-balloon-pop-assets.mjs",
    "assets:boot": "node scripts/build-boot-assets.mjs",
    "assets:sound-world": "node scripts/build-sound-world-assets.mjs",
    "assets:coloring": "node scripts/build-coloring-assets.mjs",
    "assets:sound-world-letters": "node scripts/split-sound-world-letters.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "interactjs": "^1.10.28"
  }
}
